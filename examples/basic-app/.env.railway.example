# ==============================================================================
# ACME Medusa v2 - Railway 환경 변수 설정 템플릿
# ==============================================================================

# [필수 1] 시스템 환경
NODE_ENV=production
PORT=9000

# [필수 2] Railway 플러그인 사설망 변수 참조 (Railway 대시보드 변수 문법)
# Railway PostgreSQL 연결 문자열 (사설망으로 고속 통신)
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway Redis 연결 문자열
REDIS_URL=${{Redis.REDIS_URL}}

# [필수 3] 시스템 보안 시크릿 (최소 32자 이상의 임의 문자열 생성)
JWT_SECRET=supersecret-acme-jwt-token-railway-prod-2026
COOKIE_SECRET=supersecret-acme-cookie-key-railway-prod-2026

# [필수 4] CORS 도메인 허용 목록 (쉼표 구분)
# 프론트엔드 스토어프론트 도메인 (Vercel 또는 Railway 도메인)
STORE_CORS=https://store.acme.com,https://acme-storefront.up.railway.app
# Medusa 백오피스 Admin 대시보드 허용 도메인 (현재 백엔드 서비스의 공개 URL)
ADMIN_CORS=https://acme-backend.up.railway.app
# 인증 관련 CORS
AUTH_CORS=https://store.acme.com,https://acme-storefront.up.railway.app,https://acme-backend.up.railway.app

# [선택 1] 최초 배포 시 관리자 계정 자동 생성
MEDUSA_ADMIN_EMAIL=admin@acme.local
MEDUSA_ADMIN_PASSWORD=AcmeAdminSecurePass2026!

# [선택 2] Stripe 결제 연동
STRIPE_API_KEY=sk_test_acme_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_acme_stripe_webhook_secret

# [선택 3] 파일 스토리지 (Cloudflare R2 또는 AWS S3 연동 시)
S3_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=acme-media
S3_ACCESS_KEY_ID=r2_access_key
S3_SECRET_ACCESS_KEY=r2_secret_key

